# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube Data API v3 — used by backfill script + Edge Function secret
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: direct Postgres (migrations / tooling)
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_CONTENT_GUARD=true

# Site admin (Control desk `/admin`, cafe settings, HBD approve)
# Default password if unset: MILDRPROJECT
SITE_ADMIN_PASSWORD=MILDRPROJECT
# Legacy alias still accepted:
# CAFE_SETTINGS_PASSWORD=MILDRPROJECT
# Optional HMAC secret for admin cookie (falls back to service role key)
# SITE_ADMIN_SECRET=
# CAFE_SETTINGS_SECRET=

# Optional: Dev LAN access for `next dev` (comma-separated IPs / hostnames)
# ALLOWED_DEV_ORIGINS=192.168.88.42,192.168.100.103

