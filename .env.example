# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# YouTube Data API v3 — used by backfill script + Edge Function secret
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: direct Postgres (migrations / tooling)
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cafe promotion domain. On this host only /cafe and /api/cafe are public;
# /, /events, /live, and other APIs redirect back to /cafe (or 404 for APIs).
# Leave empty for local dev and for the main domain. Comma-separated if needed.
# CAFE_HOST=cafe.example.com
# NEXT_PUBLIC_CONTENT_GUARD=true

# Site admin (Control desk `/admin`, cafe settings, HBD approve, live ops)
# Required — no default. Admin login is disabled until both are set.
# Password ≥ 12 chars; secret ≥ 32 chars (e.g. `openssl rand -base64 48`).
# Changing either one signs out every admin session.
SITE_ADMIN_PASSWORD=
SITE_ADMIN_SECRET=
# Legacy aliases still accepted: CAFE_SETTINGS_PASSWORD / CAFE_SETTINGS_SECRET

# Optional: Dev LAN access for `next dev` (comma-separated IPs / hostnames)
# ALLOWED_DEV_ORIGINS=192.168.88.42,192.168.100.103

# twitterapi.io — Edge Function secret (x-feed-sync); never commit real keys
# Also set via: npx supabase secrets set TWITTERAPI_IO_KEY=...
TWITTERAPI_IO_KEY=your-twitterapi-io-key
# Optional override for sync target (default MildRWorldEnd)
# X_USER_NAME=MildRWorldEnd

# Live Schedule Agent — Google AI Studio only (free tier; no Vertex)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# Public site URL for Agent → POST /api/live/manual (and for pg_cron target)
# LIVE_AGENT_API_BASE=https://your-production-domain
# Server secret for the agent: cron → POST /api/live/agent/run and agent → POST /api/live/manual
# Set it, then re-run scripts/setup-live-agent-cron.ts so pg_cron sends the new value.
# (Falls back to SUPABASE_SERVICE_ROLE_KEY while unset — avoid that in production.)
LIVE_AGENT_CRON_SECRET=

# Discord job alerts (success / skipped / error) — Edge secrets + Vercel/local
# Also: npx supabase secrets set DISCORD_WEBHOOK_URL=...
DISCORD_WEBHOOK_URL=

# Fan-facing live alerts (30min + LIVE NOW) — separate channel
# Also: npx supabase secrets set LIVE_DISCORD_WEBHOOK_URL=...
LIVE_DISCORD_WEBHOOK_URL=
# Alias accepted by Edge: Live_DISCORD_WEBHOOK_URL
