# ═══════════════════════════════════════════════════════════════════════
#  Mild-R Project · ตัวอย่างไฟล์ env
#  วิธีใช้: copy ไฟล์นี้เป็น `.env` แล้วใส่ค่าจริง (ห้าม commit `.env`)
#  [Vercel ✓] = ต้องตั้งบน Vercel ด้วย · [Local] = ใช้บนเครื่องเท่านั้น
# ═══════════════════════════════════════════════════════════════════════


# ── 1. 🗄️ ฐานข้อมูล Supabase ───────────────────────────────────────────
# หาค่าได้ที่ Supabase → Project Settings → API

# [Vercel ✓] ที่อยู่โปรเจกต์ + key สาธารณะ (ส่งไปเบราว์เซอร์ได้)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# [Vercel ✓] key ฝั่ง server เท่านั้น — ห้ามหลุดไปเบราว์เซอร์เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# [Local] ต่อ Postgres ตรง ใช้รัน migration (`npm run db:migrate:*`)
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# [Local] token ของ Supabase CLI (`npx supabase ...`) · Account → Access Tokens
# SUPABASE_ACCESS_TOKEN=


# ── 2. 🌐 เว็บไซต์และโดเมน ─────────────────────────────────────────────

# [Vercel ✓] ที่อยู่เว็บหลัก ใช้สร้างลิงก์ใน QR ของเกม hunt
#   production: https://cafe.mildhoneycomb.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [Vercel ✓] โดเมนแยกตามงาน — แต่ละโดเมนแสดงหน้าของตัวเองที่ `/`
#   หน้าอื่นเด้งกลับ `/` · API อื่นตอบ 404 · เว้นว่าง = ปิด (dev ใช้ได้ทุกหน้า)
#   รายละเอียด: src/lib/cafe-host.ts
# CAFE_HOST=cafe.example.com       # คาเฟ่ (/cafe + ล็อกตามเวลา)
# FANART_HOST=fanart.example.com   # หน้าส่งแฟนอาร์ต
# HBD_HOST=hbd.example.com         # หน้าส่งการ์ด HBD
# ADMIN_HOST=admin.example.com     # หน้าทีม (/admin, live ops, cafe settings)


# ── 3. 🔑 รหัสทีม (admin) ──────────────────────────────────────────────
# [Vercel ✓] ใช้กับ /admin, /cafe/settings, /cafe/secret, อนุมัติ HBD/แฟนอาร์ต, live ops
#   ต้องตั้งทั้ง 2 ตัว ไม่งั้นเข้า admin ไม่ได้
#   รหัส ≥ 12 ตัว · secret ≥ 32 ตัว (สร้าง: openssl rand -base64 48)
#   เปลี่ยนตัวไหนก็ตาม ทุกคนจะถูก log out
SITE_ADMIN_PASSWORD=
SITE_ADMIN_SECRET=
# ชื่อเก่าที่ยังใช้ได้: CAFE_SETTINGS_PASSWORD / CAFE_SETTINGS_SECRET


# ── 4. ☕ คาเฟ่ ────────────────────────────────────────────────────────

# [Vercel ✓] รหัสลับ 5 ตัวในลิงก์ QR ของเกม hunt (หลักฐาน 1→5) คั่นด้วย ,
#   แต่ละตัว ≥ 16 ตัวอักษร ห้ามซ้ำ · เว้นว่าง = เกมปิด (API 503)
#   สร้าง: openssl rand -base64 18 | tr -d '/+='
CAFE_HUNT_TOKENS=

# [Local] สวิตช์ทดสอบล็อกหน้าคาเฟ่ (doc/cafe-countdown.md · E)
#   อ่านเฉพาะ `next dev` และ preview deploy · production ไม่สนใจ คาเฟ่ไม่หลุดแน่นอน
#   เวลาเปิดจริงตั้งที่ /cafe/settings (การ์ด Page lock)
# CAFE_GATE_BYPASS=1          # 1 = ไม่สนการล็อก เปิดได้ทุกหน้า
# CAFE_PHASE=countdown        # บังคับช่วง: countdown | teaser | open


# ── 5. 📺 ไลฟ์และ Live Schedule Agent ──────────────────────────────────

# [Vercel ✓] YouTube Data API v3 · ใช้กับสคริปต์ backfill + Edge Function
YOUTUBE_API_KEY=your-youtube-api-key

# [Vercel ✓] Gemini (Google AI Studio ฟรี) · https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# [Vercel ✓] ที่อยู่ที่ Agent ใช้เรียก /api/live/manual
#   ⚠️ ต้องเป็นโดเมนเว็บหลัก (เช่น ….vercel.app) ห้ามเป็นโดเมนคาเฟ่ — API ไลฟ์ถูกปิดบนโดเมนนั้น
#   ไม่ตั้ง = ใช้ NEXT_PUBLIC_SITE_URL
# LIVE_AGENT_API_BASE=https://your-project.vercel.app

# [Vercel ✓] รหัสลับระหว่าง cron ↔ agent
#   ตั้งแล้วรัน scripts/setup-live-agent-cron.ts ใหม่ เพื่อให้ pg_cron ใช้ค่าใหม่
#   ไม่ตั้ง = ใช้ SUPABASE_SERVICE_ROLE_KEY แทน (ไม่ควรใช้บน production)
LIVE_AGENT_CRON_SECRET=


# ── 6. 🐦 X (Twitter) ──────────────────────────────────────────────────

# [Vercel ✓] twitterapi.io · ตั้งใน Supabase ด้วย:
#   npx supabase secrets set TWITTERAPI_IO_KEY=...
TWITTERAPI_IO_KEY=your-twitterapi-io-key
# บัญชีที่ดึงโพสต์ (ค่าเริ่มต้น MildRWorldEnd)
# X_USER_NAME=MildRWorldEnd
# X_USER_ID=


# ── 7. 🔔 Discord ──────────────────────────────────────────────────────

# [Vercel ✓] แจ้งเตือนทีม: งานเบื้องหลังสำเร็จ / ข้าม / error
#   ตั้งใน Supabase ด้วย: npx supabase secrets set DISCORD_WEBHOOK_URL=...
DISCORD_WEBHOOK_URL=

# [Vercel ✓] แจ้งเตือนแฟน ๆ: ก่อนไลฟ์ 30 นาที + LIVE NOW (คนละช่องกับข้างบน)
#   ตั้งใน Supabase ด้วย: npx supabase secrets set LIVE_DISCORD_WEBHOOK_URL=...
#   ชื่ออื่นที่ Edge รับได้: Live_DISCORD_WEBHOOK_URL
LIVE_DISCORD_WEBHOOK_URL=


# ── 8. 🛠️ ใช้ตอน dev เท่านั้น ──────────────────────────────────────────

# [Local] ให้มือถือหรือเครื่องอื่นในวง LAN เปิด `next dev` ได้ (IP หรือ hostname คั่นด้วย ,)
# ALLOWED_DEV_ORIGINS=192.168.88.42,192.168.100.103
